# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional. Default is openai/gpt-oss-20b (fast, current Groq production model).
# VITE_GROQ_MODEL=openai/gpt-oss-20b

# Optional. Hugging Face token for emotion tagging.
# Get a free token at https://huggingface.co/settings/tokens
# If omitted, MindBridge still replies; mood notes are skipped.
HF_TOKEN=your_hf_token_here
